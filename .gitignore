# XGen Protocol — Git ignore rules

# Rust build artifacts
target/

# Compiled binaries
bin/*.exe

# Claude Code local settings
.claude/

# Windows batch scripts — local tooling only
*.bat

# Temporary RAR packages
*.rar

# Backup folder — local archive only
docs/backup/

# Windows artifacts
Thumbs.db
Desktop.ini

# Editor artifacts
*.bak

# Visual Studio / VS Code local state
.vs/
.vscode/

# Test node runtime files — generated by smoke-test setup, not for version control
test/*/xgen-node_keypair.enc
test/*/xgen-node_identities.db
test/*/xgen-node_state.json
test/*/node.log
*.log

# Runtime space DAG stores generated by running nodes
bin/spaces/

# Claude's temporary memory notes
*_handoff.md
bin/stress-reports/xgen-stress-test_2026-05-06_07-06-21_events.json
bin/stress-reports/xgen-stress-test_2026-05-06_07-06-21_report.txt
