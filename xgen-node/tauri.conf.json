{
  "productName": "XGen Node",
  "version": "0.1.0",
  "identifier": "com.alchemydump.xgennode",
  "build": {
    "frontendDist": "C:/cargo-targets/XGenProtocol/node-dist",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm --prefix ../ui/node run build"
  },
  "app": {
    "windows": [
      {
        "title": "XGen Node",
        "label": "main",
        "width": 420,
        "height": 260,
        "decorations": false,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "process": {}
  }
}
