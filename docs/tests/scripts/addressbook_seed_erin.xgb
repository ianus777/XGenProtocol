# Address Book Seed — erin (AI identity)
# PRECONDITION: stage erin client as AI BEFORE this script:
#   xgen-client --instance <label> init --passphrase= --ai
# (measured 2026-07-24 at 86c753c: init --ai writes [ai] is_ai = true plus the
#  capability map, and register then sends is_ai = true. There is no --ai flag
#  on register itself. The earlier note that this needed a hand-edited config
#  was wrong.)
register --name erin
join --space <SPACE>
join --space <SPACE> --room <ROOM>
send --space <SPACE> --room <ROOM> --text "erin-msg-1"
status
