{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the XGen Client main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "process:default",
    "core:window:allow-start-resize-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://www.alchemydump.com" },
        { "url": "https://www.alchemydump.com/*" }
      ]
    }
  ]
}
