{
  "productName": "XGen Client",
  "version": "0.1.0",
  "identifier": "com.alchemydump.xgenclient",
  "build": {
    "frontendDist": "C:/cargo-targets/XGenProtocol/client-dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../ui/client run build"
  },
  "app": {
    "windows": [
      {
        "title": "XGen Client",
        "width": 900,
        "height": 600,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "process": {}
  }
}
