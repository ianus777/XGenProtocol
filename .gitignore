# XGen Protocol — Git ignore rules

# Rust build artifacts
target/

# Compiled binaries
bin/*.exe

# Claude Code local settings
.claude/
.claire/

# Windows batch scripts — local tooling only
*.bat

# Temporary RAR packages
*.rar

# Full fonts packages
/fonts/

# Backup folder — local archive only
docs/backup/

# Windows artifacts
Thumbs.db
Desktop.ini

# Editor artifacts
*.bak

# Visual Studio / VS Code local state
.vs/
.vscode/

# Test node runtime files — generated by smoke-test setup, not for version control
*.log

# Claude's temporary memory notes
*_handoff.md

# Temporary dev files
/bin/
/test/
**/temp/
**/tmp/

# Frontend dependencies (dist goes to C:/cargo-targets — never on Google Drive)
ui/client/node_modules/
ui/node/node_modules/

# Tauri auto-generated files (post-M1 locations after src-tauri/ removal)
xgen-client/gen/
xgen-node/gen/

# Multiparty / integration test runtime data (regenerated per run)
test_runs/
ui/sampler/node_modules/
ui/core/node_modules/
ui/common/node_modules/
# The type-gate's own deps (M-RP-TYPECHECK). ui/package-lock.json IS committed —
# it is what makes the exact svelte 5.55.5 pin real.
ui/node_modules/

# CDP verification screenshots (local eye-checks, not tracked)
ui/docs/_shots/

# Windows launcher shortcuts (machine-specific: the .lnk hardcodes an absolute target path)
*.lnk
